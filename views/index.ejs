<%- include("partials/header") %>

<main class="container">
  <section class="hero-section">
    <div class="hero-chip">Curated Thoughts & Code</div>
    <h1 class="hero-title">Thoughts crafted for the <span class="gradient-text">digital frontier.</span></h1>
    <p class="subtitle">A bespoke, distraction-free corner of the web.</p>
  </section>

  <% if (posts.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">✎</div>
      <h2>The canvas is completely blank</h2>
      <p>Every great compendium starts with an unfiltered first thought.</p>
      <a href="/posts/new" class="btn">Draft your first article</a>
    </div>
  <% } else { %>
    <section class="posts-grid">
      <% posts.forEach((post, index) => { %>
        <article class="post-card">
          <div class="post-card-top">
            <span class="post-index">#<%= String(posts.length - index).padStart(2, '0') %></span>
            <time class="post-date">
              <%= new Date(post.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
            </time>
          </div>

          <h2 class="post-title"><%= post.title %></h2>
          <p class="post-content"><%= post.content %></p>

          <div class="post-card-bottom">
            <div class="post-actions">
              <a href="/posts/<%= post.id %>/edit" class="action-btn edit">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span>Edit</span>
              </a>

              <form action="/posts/<%= post.id %>/delete" method="POST">
                <button type="submit" class="action-btn delete">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  <span>Remove</span>
                </button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </section>
  <% } %>
</main>

<%- include("partials/footer") %>