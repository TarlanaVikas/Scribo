<%- include("partials/header") %>

<main class="container">
  <div class="form-wrapper">
    <a href="/" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      <span>Back to overview</span>
    </a>

    <header class="form-header">
      <span class="hero-chip">New Dispatch</span>
      <h1>Compose Story</h1>
      <p class="subtitle">Focus your ideas. Formatted automatically with modern typography.</p>
    </header>

    <form action="/posts" method="POST" class="form-canvas">
      <div class="form-field">
        <label for="post-title">Headline</label>
        <input 
          id="post-title" 
          type="text" 
          name="title" 
          placeholder="e.g. Modern UI architectures in 2026" 
          autocomplete="off"
          required 
        />
      </div>

      <div class="form-field">
        <label for="post-content">Narrative</label>
        <textarea 
          id="post-content" 
          name="content" 
          rows="8" 
          placeholder="Unfurl your thoughts here..." 
          required
        ></textarea>
      </div>

      <div class="form-footer">
        <button type="submit" class="btn btn-primary">
          <span>Publish Story</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>
    </form>
  </div>
</main>

<%- include("partials/footer") %>