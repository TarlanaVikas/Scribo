<%- include("partials/header") %>

<main class="container">
  <div class="form-wrapper">
    <a href="/" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      <span>Cancel and back</span>
    </a>

    <header class="form-header">
      <span class="hero-chip">Revision Mode</span>
      <h1>Refine Post</h1>
      <p class="subtitle">Update phrasing, restructure, or polish existing ideas.</p>
    </header>

    <form action="/posts/<%= post.id %>" method="POST" class="form-canvas">
      <div class="form-field">
        <label for="post-title">Headline</label>
        <input 
          id="post-title" 
          type="text" 
          name="title" 
          value="<%= post.title %>" 
          required 
        />
      </div>

      <div class="form-field">
        <label for="post-content">Narrative</label>
        <textarea 
          id="post-content" 
          name="content" 
          rows="8" 
          required
        ><%= post.content %></textarea>
      </div>

      <div class="form-footer">
        <button type="submit" class="btn btn-primary">
          <span>Save Modifications</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
        </button>
      </div>
    </form>
  </div>
</main>

<%- include("partials/footer") %>